---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Placeholder from "../components/Placeholder.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import portrait from "../assets/about/colton-portrait.jpg";
import pcBuild from "../assets/homelab/pc-build.jpg";

/** Drawn from the resume — capabilities, not a job-history dump. */
const networkWork = [
  {
    title: "Multi-vendor integration",
    teaser:
      "Integrated RAD hardware into Ciena and Cisco environments across 50–100+ client sites, as the subject-matter expert for the Megaplex-4100 and Megaplex-1 platforms.",
    tags: ["Cisco IOS", "Ciena", "RAD"],
  },
  {
    title: "Carrier Ethernet & WAN",
    teaser:
      "Engineered and deployed Ethernet and WAN circuits against enterprise requirements — ETX-series and Megaplex platforms, legacy MP-2100, and AirMux wireless links.",
    tags: ["BGP", "OSPF", "VLANs"],
  },
  {
    title: "Outage response",
    teaser:
      "Diagnosed service-affecting outages and drove escalations to resolution across a large client portfolio, as the primary technical contact turning failures into fix plans.",
    tags: ["Escalation", "Troubleshooting", "Client-facing"],
  },
];

/** Case studies get full 150–250 word writeups once screenshots land. */
const caseStudies = [
  {
    title: "Mission Control",
    teaser:
      "The dashboard and agent fleet that runs my homelab — live status, job queues, and agents that pick up work without being asked. Work gets in by voice too: speak an intent, and an agent loop edits, tests, and reports back with a reviewed change.",
    tags: ["Agents", "Dashboard", "Voice"],
  },
  {
    title: "The homelab",
    teaser:
      "A Proxmox host running the services I depend on daily — virtualization, networking, storage, and monitoring, all mine end to end. Sandboxed VMs give agents room to work without touching anything that matters.",
    tags: ["Proxmox", "Infra", "Self-hosted"],
  },
];
---

<Base>
  <Hero />

  <Section
    id="networks"
    accent="--hue-network"
    eyebrow="Seven years in carrier and enterprise networks"
    title="Network Engineering"
    lede="Cisco IOS, BGP, OSPF, and carrier Ethernet — the layer everything else on this page runs on top of."
  >
    <ul class="cards">
      {
        networkWork.map((item) => (
          <li class="card">
            <h3 class="card__title">{item.title}</h3>
            <p class="card__teaser">{item.teaser}</p>
            <ul class="card__tags">
              {item.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <div class="note">
      <p>
        B.S. in Information Security and Forensics, Rochester Institute of
        Technology — High Honors. Full history in the
        <a href={site.resume}>resume</a>.
      </p>
    </div>
  </Section>

  <Section
    id="ai"
    accent="--hue-ai"
    eyebrow="Agents, fleets, and pipelines"
    title="AI Engineering"
    lede="Systems that do real operational work — not demos. Each of these runs on hardware in my house, every day."
  >
    <ul class="cards">
      {
        caseStudies.map((study) => (
          <li class="card">
            <h3 class="card__title">{study.title}</h3>
            <p class="card__teaser">{study.teaser}</p>
            <ul class="card__tags">
              {study.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
            <p class="card__note">Case study in progress</p>
          </li>
        ))
      }
    </ul>
    <figure class="figure">
      <Image
        src={pcBuild}
        alt="Two PC cases open on a workbench mid-build, one black and one white, with an AIO cooler, graphics card, and loose cabling visible."
        widths={[640, 1024, 1600]}
        sizes="(min-width: 60rem) 60rem, 100vw"
        loading="lazy"
      />
      <figcaption>
        Two of the fleet's machines mid-build. The homelab is hardware I
        assembled, not appliances I bought.
      </figcaption>
    </figure>
  </Section>

  <Section
    id="printing"
    accent="--hue-print"
    eyebrow="Design, slice, monitor, print"
    title="3D Printing"
    lede="Models I designed and printed, plus the monitoring pipeline that watches the printer so I don't have to."
  >
    <div class="grid grid--gallery">
      <Placeholder label="GLB model — orbit viewer" ratio="1 / 1" />
      <Placeholder label="GLB model — orbit viewer" ratio="1 / 1" />
      <Placeholder label="GLB model — orbit viewer" ratio="1 / 1" />
    </div>
    <div class="note">
      <p>
        Next up here: the Bambu MQTT monitoring and timelapse pipeline, written
        up as a case study with footage.
      </p>
    </div>
  </Section>

  <Section
    id="music"
    accent="--hue-music"
    eyebrow="Production and sound design"
    title="Music"
    lede="Tracks I wrote and produced. Waveform players land with the audio."
  >
    <div class="grid grid--tracks">
      <Placeholder label="Track 01 — waveform player" ratio="6 / 1" />
      <Placeholder label="Track 02 — waveform player" ratio="6 / 1" />
      <Placeholder label="Track 03 — waveform player" ratio="6 / 1" />
    </div>
  </Section>

  <Section
    id="art"
    accent="--hue-art"
    eyebrow="Paint now, VR murals next"
    title="Art"
    lede="Paintings, photographed straight-on. The next canvas is room-sized — murals painted in VR on a Quest."
  >
    <div class="grid grid--gallery">
      <Placeholder label="Painting photo" ratio="3 / 4" />
      <Placeholder label="Painting photo" ratio="3 / 4" />
      <Placeholder label="Painting photo" ratio="3 / 4" />
    </div>
  </Section>

  <Section
    id="robotics"
    accent="--hue-robotics"
    eyebrow="Build log — in progress"
    title="Robotics"
    lede="The newest discipline, documented honestly as I learn it: what I'm building, what broke, and what it taught me."
  >
    <div class="note">
      <p>
        Build log entries start as soon as the first chassis moves under its own
        power. Expect parts lists, failures, and short clips — not a finished
        showreel.
      </p>
    </div>
  </Section>

  <Section
    id="about"
    accent="--color-accent"
    eyebrow="Who's behind all this"
    title="About & Contact"
  >
    <div class="about">
      <div class="about__portrait">
        <Image
          src={portrait}
          alt="Colton Spahmer on a boat at golden hour, in a wide-brimmed hat and fishing vest, holding a largemouth bass."
          widths={[320, 640, 900]}
          sizes="(min-width: 52rem) 22rem, 100vw"
          loading="lazy"
        />
      </div>

      <div class="about__body">
        <div class="prose">
          <p>
            I'm Colton — a network engineer by trade and a builder by default.
            Seven years of Cisco IOS, BGP, and carrier Ethernet taught me how
            real infrastructure fails, which is why the AI systems I build now
            run on hardware I racked myself.
          </p>
          <p>
            B.S. in Information Security and Forensics from RIT, High Honors.
            Off the clock it's paint, printers, a DAW, and a fly rod — the
            fish above being the one time all of that stopped at once.
          </p>
        </div>

        <div class="about__links">
          <a class="about__link" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="about__link" href={site.linkedin} rel="me noopener"
            >linkedin.com/in/coltonspahmer</a
          >
          <a class="about__link" href={site.github} rel="me noopener"
            >github.com/unorthabox</a
          >
          <a class="about__link about__link--cta" href={site.resume}>
            Resume (PDF)
          </a>
        </div>
      </div>
    </div>
  </Section>
</Base>

<style>
  .cards,
  .card__tags {
    list-style: none;
    padding: 0;
  }

  /* Two case studies, so the min track is wide enough that the grid resolves to
     a 2-up and never tries for a thin third column. */
  .cards {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    border: var(--border-hairline) solid var(--color-border);
    background: var(--color-surface);
    transition: border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--section-accent) 55%, transparent);
    box-shadow: var(--shadow-md);
  }

  .card__title {
    font-size: var(--text-lg);
  }

  .card__teaser {
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-top: auto;
  }

  .tag {
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--section-accent) 12%, transparent);
    color: var(--section-accent);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
  }

  .card__note,
  .about__pending {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    gap: var(--space-md);
  }

  .grid--gallery {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .grid--tracks {
    grid-template-columns: 1fr;
  }

  .note {
    margin-top: var(--space-lg);
    padding-left: var(--space-sm);
    border-left: var(--border-thick) solid
      color-mix(in oklab, var(--section-accent) 60%, transparent);
    color: var(--color-text-muted);
    max-width: var(--width-prose);
  }

  .figure {
    margin: var(--space-xl) 0 0;
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: var(--border-hairline) solid var(--color-border);
  }

  .figure figcaption {
    margin-top: var(--space-xs);
    padding-left: var(--space-sm);
    border-left: var(--border-thick) solid
      color-mix(in oklab, var(--section-accent) 60%, transparent);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: var(--width-prose);
  }

  .about {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 52rem) {
    .about {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    }
  }

  .about__portrait :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: var(--border-hairline) solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .about__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    word-break: break-all;
  }

  .about__link:hover {
    color: var(--section-accent);
  }

  .about__link--cta {
    margin-top: var(--space-2xs);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-pill);
    border: var(--border-hairline) solid var(--color-border-strong);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    width: fit-content;
    word-break: normal;
  }

  .about__link--cta:hover {
    border-color: var(--section-accent);
    color: var(--section-accent);
  }

  .about .prose p + p {
    margin-top: var(--space-sm);
  }
</style>
