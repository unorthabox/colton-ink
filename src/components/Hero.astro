---
import { site } from "../data/site";
import Button from "./Button.astro";
import TagPill from "./TagPill.astro";

const disciplines = [
  { label: "Network engineering", accent: "--hue-network" },
  { label: "AI engineering", accent: "--hue-ai" },
  { label: "3D printing", accent: "--hue-print" },
  { label: "Music", accent: "--hue-music" },
  { label: "Art", accent: "--hue-art" },
  { label: "Robotics", accent: "--hue-robotics" },
];
---

<section class="hero" id="top">
  <div class="hero__inner container container--wide">
    <div class="hero__copy">
      <p class="hero__eyebrow">{site.tagline}</p>

      <h1 class="hero__name">
        <span class="hero__line">Colton</span>
        <span class="hero__line hero__line--accent">Spahmer</span>
      </h1>

      <p class="hero__lede prose">
        Over a decade keeping carrier networks up, and the rest of my time
        building the systems that run on them — then printing the parts,
        scoring the soundtrack, and painting the walls. Six disciplines, one
        workshop.
      </p>

      <ul class="tag-row tag-row--loose hero__tags" aria-label="Disciplines">
        {
          disciplines.map((d) => (
            <TagPill variant="outline" accent={d.accent}>
              {d.label}
            </TagPill>
          ))
        }
      </ul>

      <div class="hero__actions">
        <Button href="#engineering">See the work</Button>
        <Button variant="ghost" disabled>Get in touch</Button>
      </div>
    </div>

    <!-- Swap point for <model-viewer>: replace .hero__stage's children with the
         viewer element once Colton's GLB assets land. The stage keeps its size,
         so nothing below it moves. -->
    <div class="hero__visual">
      <div class="hero__stage" data-model-stage aria-hidden="true">
        <div class="hero__orb"></div>
        <div class="hero__grid"></div>
        <div class="hero__ring"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(var(--space-2xl), 8vw, var(--space-3xl));
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-3xl);
    }
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .hero__name {
    font-size: var(--text-5xl);
    line-height: var(--leading-none);
    margin-bottom: var(--space-md);
  }

  .hero__line {
    display: block;
  }

  .hero__line--accent {
    background: linear-gradient(
      100deg,
      var(--hue-ai),
      var(--hue-art) 55%,
      var(--hue-print)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }

  .hero__tags {
    margin-block: var(--space-lg);
  }


  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }


  /* --- Visual stage ---------------------------------------------------- */

  .hero__visual {
    display: grid;
    place-items: center;
  }

  .hero__stage {
    position: relative;
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .hero__orb {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--hue-ai),
      var(--hue-music),
      var(--hue-art),
      var(--hue-print),
      var(--hue-robotics),
      var(--hue-ai)
    );
    filter: blur(2px);
    opacity: 0.85;
    animation: spin 24s linear infinite;
  }

  /* Punches the centre out, leaving a thick luminous ring. */
  .hero__orb::after {
    content: "";
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: var(--color-bg);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: linear-gradient(
        color-mix(in oklab, var(--color-text) 12%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in oklab, var(--color-text) 12%, transparent) 1px,
        transparent 1px
      );
    background-size: 2.5rem 2.5rem;
    mask-image: radial-gradient(circle at center, #000 42%, transparent 68%);
    -webkit-mask-image: radial-gradient(
      circle at center,
      #000 42%,
      transparent 68%
    );
  }

  .hero__ring {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    border: var(--border-hairline) dashed
      color-mix(in oklab, var(--color-text) 22%, transparent);
    animation: spin 60s linear infinite reverse;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__orb,
    .hero__ring {
      animation: none;
    }
  }
</style>
