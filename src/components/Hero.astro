---
import { site } from "../data/site";
import Button from "./Button.astro";
import TagPill from "./TagPill.astro";

const disciplines = [
  { label: "Network engineering", accent: "--hue-network" },
  { label: "AI engineering", accent: "--hue-ai" },
  { label: "3D printing", accent: "--hue-print" },
  { label: "Music", accent: "--hue-music" },
  { label: "Art", accent: "--hue-art" },
  { label: "Robotics", accent: "--hue-robotics" },
];
---

<section class="hero" id="top">
  <div class="hero__inner container container--wide">
    <div class="hero__copy">
      <p class="hero__eyebrow">{site.tagline}</p>

      <h1 class="hero__name">
        <span class="hero__line">Colton</span>
        <span class="hero__line hero__line--accent">Spahmer</span>
      </h1>

      <p class="hero__lede prose">
        Over a decade keeping carrier networks up, and the rest of my time
        building the systems that run on them — then printing the parts,
        scoring the soundtrack, and painting the walls. Six disciplines, one
        workshop.
      </p>

      <ul class="tag-row tag-row--loose hero__tags" aria-label="Disciplines">
        {
          disciplines.map((d) => (
            <TagPill variant="outline" accent={d.accent}>
              {d.label}
            </TagPill>
          ))
        }
      </ul>

      <div class="hero__actions">
        <Button href="#engineering">See the work</Button>
        <Button variant="ghost" disabled>Get in touch</Button>
      </div>
    </div>

    <!-- Swap point for <model-viewer>: replace .hero__stage's children with the
         viewer element once Colton's GLB assets land. The stage keeps its size,
         so nothing below it moves. -->
    <div class="hero__visual">
      <div class="hero__stage" data-model-stage aria-hidden="true">
        <div class="hero__orb"></div>
        <div class="hero__grid"></div>
        <div class="hero__ring"></div>
      </div>
    </div>
  </div>
</section>

