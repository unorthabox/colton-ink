---
/**
 * A deliberately blank slot for content that is queued but not yet supplied
 * (models, photos, tracks). Reads as a designed empty state rather than a
 * broken page, and is meant to be deleted as each section fills in.
 */
interface Props {
  label: string;
  /** CSS aspect-ratio for the box, e.g. "4 / 3". */
  ratio?: string;
}

const { label, ratio = "4 / 3" } = Astro.props;
---

<div class="placeholder" style={`aspect-ratio: ${ratio};`}>
  <span class="placeholder__label">{label}</span>
</div>

