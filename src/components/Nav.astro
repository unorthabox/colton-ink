---
import { sections, site } from "../data/site";
---

<a class="skip" href="#main">Skip to content</a>

<header class="nav" data-nav>
  <div class="nav__inner container container--wide">
    <a class="nav__brand" href="#top">
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__wordmark">{site.domain}</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {
        sections.map((section) => (
          <a
            class="nav__link"
            href={`#${section.id}`}
            style={`--section-accent: var(${section.accent});`}
          >
            {section.label}
          </a>
        ))
      }
    </nav>

    <button
      class="nav__theme"
      type="button"
      data-theme-toggle
      aria-label="Switch colour theme"
      title="Switch colour theme"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <circle cx="12" cy="12" r="5" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 1.5v2.2M12 20.3v2.2M22.5 12h-2.2M3.7 12H1.5"></path>
          <path d="M19.4 4.6l-1.6 1.6M6.2 17.8l-1.6 1.6M19.4 19.4l-1.6-1.6M6.2 6.2L4.6 4.6"
          ></path>
        </g>
      </svg>
    </button>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: var(--z-modal);
    padding: var(--space-2xs) var(--space-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .skip:focus {
    transform: translateY(0);
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in oklab, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: var(--border-hairline) solid transparent;
    transition: border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  /* Set by the scroll listener once the page moves off the top. */
  .nav[data-scrolled] {
    border-bottom-color: var(--color-border);
    background: color-mix(in oklab, var(--color-bg) 92%, transparent);
  }

  .nav__inner {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-strong);
    margin-inline-end: auto;
  }

  .nav__mark {
    width: 0.85em;
    height: 0.85em;
    border-radius: var(--radius-xs);
    background: linear-gradient(
      135deg,
      var(--hue-ai),
      var(--hue-art) 45%,
      var(--hue-print)
    );
    box-shadow: var(--glow-accent);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    overflow-x: auto;
    scrollbar-width: none;
    /* Keeps the row from pushing the toggle off small screens. */
    min-width: 0;
  }

  .nav__links::-webkit-scrollbar {
    display: none;
  }

  .nav__link {
    position: relative;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--section-accent);
    background: color-mix(in oklab, var(--section-accent) 12%, transparent);
  }

  .nav__theme {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    border: var(--border-hairline) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-spring);
  }

  .nav__theme:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: rotate(18deg);
  }

  /* No JS, no toggle — the site still follows the system theme. */
  html:not(.js) .nav__theme {
    display: none;
  }

  @media (max-width: 40rem) {
    .nav__wordmark {
      display: none;
    }
  }
</style>

<script>
  // Theme choice persists across visits; absent a choice we follow the system.
  const root = document.documentElement;
  const STORAGE_KEY = "colton-ink-theme";

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
    const current = root.dataset.theme ?? (systemDark ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem(STORAGE_KEY, next);
  });

  const nav = document.querySelector("[data-nav]") as HTMLElement | null;
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.dataset.scrolled = "";
    else delete nav.dataset.scrolled;
  };
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });
</script>
