---
import { about, chapters, site } from "../data/site";
---

<a class="skip" href="#main">Skip to content</a>

<header class="nav" data-nav>
  <div class="nav__inner container container--wide">
    <a class="nav__brand" href="#top">
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__wordmark">{site.domain}</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {
        chapters.map((chapter) => (
          <a
            class="nav__link"
            href={`#${chapter.id}`}
            style={`--section-accent: var(${chapter.accent});`}
          >
            {chapter.label}
          </a>
        ))
      }
      <a class="nav__link" href={`#${about.id}`}>{about.label}</a>
    </nav>

    <button
      class="nav__theme"
      type="button"
      data-theme-toggle
      aria-label="Switch colour theme"
      title="Switch colour theme"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <circle cx="12" cy="12" r="5" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 1.5v2.2M12 20.3v2.2M22.5 12h-2.2M3.7 12H1.5"></path>
          <path d="M19.4 4.6l-1.6 1.6M6.2 17.8l-1.6 1.6M19.4 19.4l-1.6-1.6M6.2 6.2L4.6 4.6"
          ></path>
        </g>
      </svg>
    </button>
  </div>
</header>


<script>
  // Theme choice persists across visits; absent a choice we follow the system.
  const root = document.documentElement;
  const STORAGE_KEY = "colton-ink-theme";

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
    const current = root.dataset.theme ?? (systemDark ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem(STORAGE_KEY, next);
  });

  const nav = document.querySelector("[data-nav]") as HTMLElement | null;
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.dataset.scrolled = "";
    else delete nav.dataset.scrolled;
  };
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });
</script>
