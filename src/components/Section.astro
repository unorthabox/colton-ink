---
import SectionHeader from "./SectionHeader.astro";

/**
 * A subsection inside a Chapter. Sets --section-accent once; everything
 * nested — eyebrows, rules, tags, hovers — inherits it.
 */
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  /** Token name (e.g. "--hue-print") that tints everything inside. */
  accent: string;
}

const { id, eyebrow, title, lede, accent } = Astro.props;
---

<section class="section" id={id} style={`--section-accent: var(${accent});`}>
  <div class="container container--wide">
    <SectionHeader eyebrow={eyebrow} title={title} lede={lede} level={3} />
    <slot />
  </div>
</section>

