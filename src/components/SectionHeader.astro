---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Heading level — sections use h2, sub-blocks can pass 3. */
  level?: 2 | 3;
}

const { eyebrow, title, lede, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---

<div class="section-header">
  <p class="eyebrow">{eyebrow}</p>
  <Heading class="section-header__title">{title}</Heading>
  {lede && <p class="section-header__lede prose">{lede}</p>}
</div>

